{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src", "lib", "components", "vite.config.ts"],
  "exclude": ["node_modules", ".next", "dist", "app", "proxy.ts", "next.config.ts", "playwright.config.ts", "lib/supabase/server.ts", "lib/supabase/middleware.ts"]
}
